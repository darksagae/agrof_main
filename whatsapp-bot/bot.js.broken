async function handleGeneralInquiry(msg, text) {
    // Smart response based on keywords
    if (text.match(/fertilizer|dap|urea|npk|nutrient/i)) {
        await msg.reply('*FERTILIZERS & SOIL NUTRIENTS*\n\nWe stock a comprehensive range of premium fertilizers including:\n\n▪️ NPK Compounds\n▪️ Urea & DAP\n▪️ Organic Fertilizers\n▪️ Foliar Nutrients\n\nReply *PRODUCTS* to view our complete fertilizer catalog.\n\n_AGROF - Quality Agricultural Inputs_');
    } else if (text.match(/seed|seedling|nursery/i)) {
        await msg.reply('*SEEDS & SEEDLINGS*\n\nDiscover our selection of certified quality seeds:\n\n▪️ Vegetable Seeds\n▪️ Maize & Grain Seeds\n▪️ Nursery Seedlings\n▪️ Hybrid Varieties\n\nReply *PRODUCTS* to explore our seed collection.\n\n📞 Expert advice: +256 705 223 777');
    } else if (text.match(/deliver|delivery|transport|shipping/i)) {
        await msg.reply('*DELIVERY SERVICES*\n\nAGROF offers reliable delivery across Uganda.\n\n▪️ Delivery timeframe: 24-48 hours\n▪️ Coverage: Nationwide\n▪️ Pickup: Available at our store\n\nFor delivery quotes and scheduling:\n📞 +256 705 223 777\n\n_Fast & Reliable Agricultural Logistics_');
    } else if (text.match(/payment|pay|price|cost|how much/i)) {
        await msg.reply('*PAYMENT OPTIONS*\n\nWe accept the following payment methods:\n\n▪️ Mobile Money (MTN/Airtel)\n▪️ Bank Transfer\n▪️ Cash on Delivery\n▪️ Cash at Store\n\nReply *PRICE* to view product pricing.\n\nFor payment assistance:\n📞 +256 705 223 777');
    } else if (text.match(/fungicide|disease|blight|pest/i)) {
        await msg.reply('*CROP PROTECTION SOLUTIONS*\n\nProtect your crops with our range of:\n\n▪️ Fungicides\n▪️ Herbicides\n▪️ Pest Control Products\n\nReply *PRODUCTS* to view our crop protection catalog.\n\n_Professional Agricultural Solutions_');
    } else {
        await msg.reply('*AGROF AGRICULTURAL SERVICES*\n\nHow may we assist you today?\n\n▪️ *PRODUCTS* - Browse catalog\n▪️ *ORDER* - Place an order\n▪️ *CONTACT* - Speak with our team\n\nFor immediate assistance:\n📞 +256 705 223 777\n🌐 www.agrof.farm');
    }
}

// ==================== HELPER FUNCTIONS ====================

async function getContactName(msg) {
    try {
        const contact = await msg.getContact();
        return contact.pushname || contact.name || contact.number || 'Customer';
    } catch {
        return 'Customer';
    }
}

async function notifyAdmins(message) {
    if (ADMIN_NUMBERS.length === 0) return;
    
    for (const adminNumber of ADMIN_NUMBERS) {
        try {
            const chatId = adminNumber.includes('@c.us') ? adminNumber : `${adminNumber}@c.us`;
            await client.sendMessage(chatId, message);
        } catch (error) {
            console.error(`Failed to notify admin ${adminNumber}:`, error.message);
        }
    }
}

// ==================== OUTBOUND MESSAGE API ====================

const express = require('express');
const app = express();
app.use(express.json());

// API to send messages from automation system
app.post('/send', async (req, res) => {
    try {
        const { to, message } = req.body;
        
        if (!to || !message) {
            return res.status(400).json({ error: 'Missing to or message' });
        }
        
        const chatId = to.includes('@c.us') ? to : `${to}@c.us`;
        await client.sendMessage(chatId, message);
        
        res.json({ success: true, message: 'Message sent' });
    } catch (error) {
        console.error('Error sending message:', error);
        res.status(500).json({ error: error.message });
    }
});

// Health check
app.get('/health', (req, res) => {
    res.json({
        status: 'OK',
        ready: client.info ? true : false,
        info: client.info
    });
});

const API_PORT = process.env.API_PORT || 3003;
app.listen(API_PORT, () => {
    console.log(`\n📡 WhatsApp Bot API listening on port ${API_PORT}`);
    console.log(`   POST http://localhost:${API_PORT}/send - Send messages`);
    console.log(`   GET  http://localhost:${API_PORT}/health - Health check\n`);
});

// ==================== START BOT ====================

console.log('🚀 Starting AGROF WhatsApp Bot...\n');
client.initialize();

// Graceful shutdown
process.on('SIGINT', async () => {
    console.log('\n🛑 Shutting down WhatsApp bot...');
    await client.destroy();
    process.exit(0);
});

async function handlePriceInquiry(msg, text) {
    await msg.reply('Retrieving current pricing information...');
    
    try {
        const response = await fetch(`${STORE_API}/api/products?limit=30`);
        const products = await response.json();
        
        let priceMessage = `*AGROF PRICE LIST*\n_Current Market Prices_\n\n━━━━━━━━━━━━━━━━━━━━━━\n\n`;
        
        // Group by category
        const byCategory = {};
        products.forEach(p => {
            const cat = p.category_display_name || p.category_name || 'Other';
            if (!byCategory[cat]) byCategory[cat] = [];
            byCategory[cat].push(p);
        });
        
        for (const [category, items] of Object.entries(byCategory)) {
            priceMessage += `*${category.toUpperCase()}*\n\n`;
            items.slice(0, 5).forEach(p => {
                priceMessage += `▪️ ${p.name}\n   ${p.price}\n\n`;
            });
        }
        
        priceMessage += `━━━━━━━━━━━━━━━━━━━━━━\n\n`;
        priceMessage += `*To place an order:*\nReply: *ORDER [product name] [quantity]*\n\n`;
        priceMessage += `📞 Bulk orders: +256 705 223 777\n🌐 Full catalog: www.agrof.farm`;
        
        await msg.reply(priceMessage);
        
    } catch (error) {
        console.error('Error fetching prices:', error);
        await msg.reply('We apologize for the inconvenience. For pricing information, please contact:\n\n📞 +256 705 223 777\n📧 support@agrof.farm');
    }
}

async function handleOrderTracking(msg) {
    await msg.reply('📦 To track your order, please provide your order number.\n\nExample: #ORD123456');
}

async function handleSupport(msg) {
    const supportMessage = `📞 *CONTACT INFORMATION*

🏢 AGROF Agricultural Services

📱 Phone: +256 705 223 777
📧 Email: support@agrof.farm
🌐 Website: www.agrof.farm

⏰ *Working Hours:*
Monday - Friday: 8:00 AM - 6:00 PM
Saturday: 9:00 AM - 4:00 PM
Sunday: Closed

📍 *Location:*
Kampala, Uganda

💬 You can also continue chatting here, and our team will respond shortly!`;

    await msg.reply(supportMessage);
}

async function handleGeneralInquiry(msg, text) {
    // Smart response based on keywords
    if (text.match(/fertilizer|dap|urea|npk|nutrient/i)) {
        await msg.reply('*FERTILIZERS & SOIL NUTRIENTS*\n\nWe stock a comprehensive range of premium fertilizers including:\n\n▪️ NPK Compounds\n▪️ Urea & DAP\n▪️ Organic Fertilizers\n▪️ Foliar Nutrients\n\nReply *PRODUCTS* to view our complete fertilizer catalog.\n\n_AGROF - Quality Agricultural Inputs_');
    } else if (text.match(/seed|seedling|nursery/i)) {
        await msg.reply('*SEEDS & SEEDLINGS*\n\nDiscover our selection of certified quality seeds:\n\n▪️ Vegetable Seeds\n▪️ Maize & Grain Seeds\n▪️ Nursery Seedlings\n▪️ Hybrid Varieties\n\nReply *PRODUCTS* to explore our seed collection.\n\n📞 Expert advice: +256 705 223 777');
    } else if (text.match(/deliver|delivery|transport|shipping/i)) {
        await msg.reply('*DELIVERY SERVICES*\n\nAGROF offers reliable delivery across Uganda.\n\n▪️ Delivery timeframe: 24-48 hours\n▪️ Coverage: Nationwide\n▪️ Pickup: Available at our store\n\nFor delivery quotes and scheduling:\n📞 +256 705 223 777\n\n_Fast & Reliable Agricultural Logistics_');
    } else if (text.match(/payment|pay|price|cost|how much/i)) {
        await msg.reply('*PAYMENT OPTIONS*\n\nWe accept the following payment methods:\n\n▪️ Mobile Money (MTN/Airtel)\n▪️ Bank Transfer\n▪️ Cash on Delivery\n▪️ Cash at Store\n\nReply *PRICE* to view product pricing.\n\nFor payment assistance:\n📞 +256 705 223 777');
    } else if (text.match(/fungicide|disease|blight|pest/i)) {
        await msg.reply('*CROP PROTECTION SOLUTIONS*\n\nProtect your crops with our range of:\n\n▪️ Fungicides\n▪️ Herbicides\n▪️ Pest Control Products\n\nReply *PRODUCTS* to view our crop protection catalog.\n\n_Professional Agricultural Solutions_');
    } else {
        await msg.reply('*AGROF AGRICULTURAL SERVICES*\n\nHow may we assist you today?\n\n▪️ *PRODUCTS* - Browse catalog\n▪️ *ORDER* - Place an order\n▪️ *CONTACT* - Speak with our team\n\nFor immediate assistance:\n📞 +256 705 223 777\n🌐 www.agrof.farm');
    }
}

