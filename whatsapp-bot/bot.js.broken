/**
 * AGROF WhatsApp Bot
 * Automatically handle customer orders, inquiries, and notifications via WhatsApp
 */

const { Client, LocalAuth, MessageMedia } = require('whatsapp-web.js');
const qrcode = require('qrcode-terminal');
const fetch = require('node-fetch');
require('dotenv').config();

// Import admin command handler (V2 - Conversational Portal)
const AdminCommandsV2 = require('./admin-commands-v2');

// Configuration
const STORE_API = process.env.STORE_API || 'http://store-backend:3001/api';
const AUTOMATION_API = process.env.AUTOMATION_API || 'http://automation-engine:3002';
const ADMIN_NUMBERS = (process.env.ADMIN_NUMBERS || '').split(',').filter(n => n);

// Initialize admin handler
const adminHandler = new AdminCommandsV2(STORE_API, ADMIN_NUMBERS);

console.log('🔐 Admin Portal ready with secret triggers:');
console.log('   👁️ godeye - News Control');
console.log('   🌀 void - Store Management');
console.log('   ✨ destiny - Market Control');
console.log('   🔮 oracle - Analytics');
console.log('   🛡️ guardian - Customer Management');
console.log('   🔥 phoenix - System Operations');
console.log('   ⚡ nexus - Automation Control');

// Initialize WhatsApp Client
const client = new Client({
    authStrategy: new LocalAuth({
        dataPath: './whatsapp-session'
    }),
    puppeteer: {
        headless: true,
        args: ['--no-sandbox', '--disable-setuid-sandbox']
    }
});

// Store for conversation state
const conversations = new Map();

// ==================== WHATSAPP EVENTS ====================

client.on('qr', (qr) => {
    console.log('\n📱 SCAN THIS QR CODE WITH YOUR WHATSAPP BUSINESS APP:\n');
    qrcode.generate(qr, { small: true });
    console.log('\n✅ Open WhatsApp Business on your phone');
    console.log('✅ Go to Settings > Linked Devices');
    console.log('✅ Tap "Link a Device"');
    console.log('✅ Scan the QR code above\n');
});

client.on('authenticated', () => {
    console.log('✅ WhatsApp authenticated successfully!');
});

client.on('ready', () => {
    console.log('🎉 AGROF WhatsApp Bot is ready!');
    console.log('📱 You can now receive and send messages');
    console.log('💬 Bot is listening for customer messages...\n');
    
    // Notify admins that bot is online
    notifyAdmins('🤖 AGROF WhatsApp Bot is now ONLINE and ready to serve customers!');
});

client.on('message', async (msg) => {
    try {
        await handleMessage(msg);
    } catch (error) {
        console.error('❌ Error handling message:', error);
        await msg.reply('⚠️ Sorry, I encountered an error. Please try again or contact support.');
    }
});

client.on('disconnected', (reason) => {
    console.log('❌ WhatsApp disconnected:', reason);
    console.log('🔄 Attempting to reconnect...');
});

// ==================== MESSAGE HANDLER ====================

async function handleMessage(msg) {
    const sender = msg.from;
    const text = msg.body.trim();
    const senderName = await getContactName(msg);
    
    console.log(`\n📩 Message from ${senderName} (${sender}):`);
    console.log(`💬 "${text}"\n`);
    
    // Ignore group messages
    if (msg.from.includes('@g.us')) {
        return;
    }
    
    // Ignore own messages
    if (msg.fromMe) {
        return;
    }
    
    // Check for admin commands (secret triggers + legacy)
    const adminHandled = await adminHandler.handleAdminMessage(msg, text);
    if (adminHandled) return;
    
    // Check for confirmation of admin actions
    if (text.toLowerCase().startsWith('confirm delete')) {
        if (adminHandler.isAdmin(msg.from)) {
            const productId = text.match(/\d+/);
            if (productId) {
                await adminHandler.processDeleteProduct(msg, productId[0]);
                conversations.delete(msg.from);
                return;
            }
        }
    }
    
    // Check if admin is in product addition flow
    const adminState = conversations.get(msg.from);
    if (adminState && adminState.type === 'admin_add_product' && adminHandler.isAdmin(msg.from)) {
        await adminHandler.processAddProduct(msg, text);
        conversations.delete(msg.from);
        return;
    }
    
    // Command routing
    const command = text.toLowerCase();
    
    // Greeting
    if (command.match(/^(hi|hello|hey|good morning|good afternoon|good evening|jambo|habari)/i)) {
        await handleGreeting(msg, senderName);
    }
    // Menu
    else if (command.match(/^(menu|help|options|commands)/i)) {
        await sendMenu(msg);
    }
    // Check stock
    else if (command.match(/^(stock|inventory|available|products)/i)) {
        await handleStockInquiry(msg);
    }
    // Order
    else if (command.match(/^(order|buy|purchase|i want|i need)/i)) {
        await handleOrderRequest(msg, text);
    }
    // Check prices
    else if (command.match(/^(price|cost|how much)/i)) {
        await handlePriceInquiry(msg, text);
    }
    // Track order
    else if (command.match(/^(track|status|my order)/i)) {
        await handleOrderTracking(msg);
    }
    // Contact/Support
    else if (command.match(/^(contact|support|help me|call)/i)) {
        await handleSupport(msg);
    }
    // Yes/No responses (for confirmations)
    else if (command.match(/^(yes|confirm|ok|proceed)/i)) {
        await handleConfirmation(msg, true);
    }
    else if (command.match(/^(no|cancel|stop)/i)) {
        await handleConfirmation(msg, false);
    }
    // Default - AI-like response
    else {
        await handleGeneralInquiry(msg, text);
    }
}

// ==================== COMMAND HANDLERS ====================

