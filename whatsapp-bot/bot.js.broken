async function handleStockInquiry(msg) {
    await msg.reply('Please wait while we prepare our current product catalog...');
    
    try {
        const response = await fetch(`${STORE_API}/api/products?limit=500`);
        const allProducts = await response.json();
        
        // Filter in-stock products
        const inStock = allProducts.filter(p => p.quantity_in_stock > 0);
        
        if (inStock.length === 0) {
            await msg.reply('We apologize, but our inventory is currently being restocked. Please contact us at +256 705 223 777 for immediate assistance.');
            return;
        }
        
        // Group by category
        const categories = {};
        inStock.forEach(p => {
            const cat = p.category_display_name || p.category_name || 'Other';
            if (!categories[cat]) categories[cat] = [];
            categories[cat].push(p);
        });
        
        let stockMessage = `*AGROF PRODUCT CATALOG*\n_Premium Agricultural Solutions_\n\n━━━━━━━━━━━━━━━━━━━━━━\n\n`;
        
        for (const [category, items] of Object.entries(categories)) {
            stockMessage += `*${category.toUpperCase()}*\n`;
            stockMessage += `${items.length} products available\n\n`;
            items.slice(0, 8).forEach(item => {
                stockMessage += `▪️ ${item.name}\n`;
            });
            if (items.length > 8) {
                stockMessage += `   _...and ${items.length - 8} more_\n`;
            }
            stockMessage += '\n';
        }
        
        stockMessage += `━━━━━━━━━━━━━━━━━━━━━━\n\n*Total: ${inStock.length} products in stock*\n\n`;
        stockMessage += `To view detailed information and place an order:\n• Reply: *ORDER [product name]*\n\n`;
        stockMessage += `📞 Questions? Call +256 705 223 777\n🌐 Visit www.agrof.farm`;
        
        await msg.reply(stockMessage);
        
    } catch (error) {
        console.error('Error fetching stock:', error);
        await msg.reply('We apologize for the inconvenience. Please contact our team at +256 705 223 777 or support@agrof.farm for assistance.');
    }
}

async function handleOrderRequest(msg, text) {
    await msg.reply('Thank you for your interest. Let me assist you with your order...');
    
    // Try to parse order from message
    const orderMatch = text.match(/(\d+)\s*(kg|bags?|units?|pcs?|pieces?)?\s*(.+)/i);
    
    if (orderMatch) {
        const quantity = orderMatch[1];
        const unit = orderMatch[2] || 'units';
        const productName = orderMatch[3].trim();
        
        await msg.reply(`Searching for: *${productName}*\n\nPlease wait...`);
        
        try {
            // Search for product
            const response = await fetch(`${STORE_API}/api/search?q=${encodeURIComponent(productName)}`);
            const products = await response.json();
            
            if (products.length === 0) {
                await msg.reply(`We apologize, but "${productName}" is not currently available in our catalog.\n\nFor product inquiries:\n📞 +256 705 223 777\n📧 support@agrof.farm\n\nReply *PRODUCTS* to browse our full catalog.`);
                return;
            }
            
            const product = products[0];
            
            // Send product image if available
            if (product.image_url) {
                try {
                    // Properly encode the URL path
                    const pathParts = product.image_url.split('/').map(part => {
                        if (part === '' || part === 'api' || part === 'images') {
                            return part;
                        }
                        return encodeURIComponent(part);
                    });
                    const encodedPath = pathParts.join('/');
                    const imageUrl = `${STORE_API.replace('/api', '')}${encodedPath}`;
                    
                    console.log('📸 Fetching product image:', imageUrl);
                    
                    const media = await MessageMedia.fromUrl(imageUrl);
                    
                    const imageCaption = `*${product.name}*\n\n${product.description ? product.description.substring(0, 150) + '...' : 'Premium agricultural product'}\n\n━━━━━━━━━━━━━━━━━━━━━━`;
                    
                    await client.sendMessage(msg.from, media, { caption: imageCaption });
                    console.log('✅ Product image sent successfully');
                } catch (imgError) {
                    console.log('❌ Could not send image:', imgError.message);
                }
            }
            
            // Check availability
            if (product.quantity_in_stock < quantity) {
                const altMessage = `*STOCK AVAILABILITY*\n\n` +
                    `Product: ${product.name}\n` +
                    `Requested: ${quantity} ${product.unit_of_measure}\n` +
                    `Available: ${product.quantity_in_stock} ${product.unit_of_measure}\n\n` +
                    `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                    `Would you like to proceed with ${product.quantity_in_stock} ${product.unit_of_measure}?\n\n` +
                    `Reply *YES* to confirm or *NO* to cancel`;
                
                await msg.reply(altMessage);
                
                // Save conversation state
                conversations.set(msg.from, {
                    type: 'order_alternative',
                    product: product,
                    quantity: product.quantity_in_stock,
                    customerName: await getContactName(msg)
                });
                return;
            }
            
            // Calculate total (parse price)
            const priceMatch = product.price.match(/[\d,]+/);
            const unitPrice = priceMatch ? parseInt(priceMatch[0].replace(/,/g, '')) : 0;
            const total = unitPrice * quantity;
            
            const confirmMessage = `*ORDER SUMMARY*\n\n` +
                `Product: ${product.name}\n` +
                `Quantity: ${quantity} ${product.unit_of_measure}\n` +
                `Unit Price: UGX ${unitPrice.toLocaleString()}\n` +
                `━━━━━━━━━━━━━━━━━━━━━━\n` +
                `*Total Amount: UGX ${total.toLocaleString()}*\n\n` +
                `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                `Reply *YES* to confirm your order\n` +
                `Reply *NO* to cancel`;
            
            await msg.reply(confirmMessage);
            
            // Save conversation state
            conversations.set(msg.from, {
                type: 'order_confirm',
                product: product,
                quantity: parseInt(quantity),
                total: total,
                unitPrice: unitPrice,
                customerName: await getContactName(msg)
            });
            
        } catch (error) {
            console.error('Error processing order:', error);
            await msg.reply('We apologize for the technical difficulty. Please contact us directly:\n\n📞 +256 705 223 777\n📧 support@agrof.farm');
        }
        
    } else {
        // Guide user
        await msg.reply(`*HOW TO ORDER*\n\n` +
            `Please specify the product and quantity:\n\n` +
            `*Example:*\n` +
            `• Order 50kg DAP fertilizer\n` +
            `• I want 10 bags of NPK\n` +
            `• 5kg Urea\n\n` +
            `Or reply *PRODUCTS* to browse our catalog first.\n\n` +
            `_AGROF - Professional Agricultural Solutions_`);
    }
}

async function handleConfirmation(msg, confirmed) {
    const state = conversations.get(msg.from);
    
    if (!state) {
        await msg.reply('Please start a new order by typing *ORDER* or browse our *PRODUCTS*.');
        return;
    }
    
    if (state.type === 'order_confirm' || state.type === 'order_alternative') {
        if (confirmed) {
            await msg.reply('Processing your order...');
            
            try {
                const orderNumber = 'AGROF' + Date.now().toString().slice(-8);
                const customerPhone = msg.from.replace('@c.us', '');
                
                // Send product image with order details
                if (state.product.image_url) {
                    try {
                        // Properly encode the URL path
                        const pathParts = state.product.image_url.split('/').map(part => {
                            if (part === '' || part === 'api' || part === 'images') {
                                return part;
                            }
                            return encodeURIComponent(part);
                        });
                        const encodedPath = pathParts.join('/');
                        const imageUrl = `${STORE_API.replace('/api', '')}${encodedPath}`;
                        
                        console.log('📸 Sending order confirmation image:', imageUrl);
                        
                        const media = await MessageMedia.fromUrl(imageUrl);
                        
                        const orderCaption = `*ORDER CONFIRMED*\n\n` +
                            `Order #${orderNumber}\n` +
                            `${state.product.name}\n` +
                            `Quantity: ${state.quantity} ${state.product.unit_of_measure}\n` +
                            `Amount: UGX ${state.total.toLocaleString()}\n\n` +
                            `━━━━━━━━━━━━━━━━━━━━━━`;
                        
                        await client.sendMessage(msg.from, media, { caption: orderCaption });
                        console.log('✅ Order confirmation image sent successfully');
                    } catch (imgError) {
                        console.log('❌ Could not send order image:', imgError.message);
                        console.log('   Image URL was:', state.product.image_url);
                    }
                }
                
                // Send payment instructions
                const paymentMessage = `*PAYMENT INSTRUCTIONS*\n\n` +
                    `Order: #${orderNumber}\n` +
                    `Amount: UGX ${state.total.toLocaleString()}\n\n` +
                    `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                    `*Payment Options:*\n\n` +
                    `▪️ *Mobile Money (MTN/Airtel)*\n` +
                    `   Send to: 0705 223 777\n` +
                    `   Name: AGROF Services\n\n` +
                    `▪️ *Bank Transfer*\n` +
                    `   Bank: Stanbic Bank\n` +
                    `   Account: [Available on request]\n\n` +
                    `▪️ *Cash on Delivery*\n` +
                    `   Pay when you receive\n\n` +
                    `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                    `After payment, send screenshot to:\n` +
                    `📞 WhatsApp: +256 705 223 777\n\n` +
                    `*Delivery:* Within 24-48 hours\n` +
                    `*Pickup:* Available at our store\n\n` +
                    `Thank you for choosing AGROF! 🌾`;
                
                await msg.reply(paymentMessage);
                
                // Create order via automation
                await fetch(`${AUTOMATION_API}/api/events/whatsapp_order`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderId: orderNumber,
                        customer: customerPhone,
                        customerName: state.customerName,
                        product: state.product,
                        quantity: state.quantity,
                        unitPrice: state.unitPrice,
                        total: state.total,
                        timestamp: new Date().toISOString()
                    })
                });
                
                // Notify admins with complete details
                const adminNotification = `*NEW ORDER RECEIVED*\n\n` +
                    `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                    `*Order Details:*\n` +
                    `Order #: ${orderNumber}\n` +
                    `Time: ${new Date().toLocaleString('en-UG')}\n\n` +
                    `*Customer Information:*\n` +
                    `Name: ${state.customerName}\n` +
                    `Phone: +${customerPhone}\n` +
                    `WhatsApp: ${msg.from}\n\n` +
                    `*Product Details:*\n` +
                    `Product: ${state.product.name}\n` +
                    `Category: ${state.product.category_display_name || state.product.category_name}\n` +
                    `Quantity: ${state.quantity} ${state.product.unit_of_measure}\n` +
                    `Unit Price: UGX ${state.unitPrice.toLocaleString()}\n\n` +
                    `*Payment:*\n` +
                    `Total Amount: UGX ${state.total.toLocaleString()}\n` +
                    `Status: Pending\n` +
                    `Method: To be confirmed\n\n` +
                    `*Inventory Impact:*\n` +
                    `Current Stock: ${state.product.quantity_in_stock} ${state.product.unit_of_measure}\n` +
                    `After Order: ${state.product.quantity_in_stock - state.quantity} ${state.product.unit_of_measure}\n\n` +
                    `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
                    `⚡ *Action Required:*\n` +
                    `1. Prepare order for fulfillment\n` +
                    `2. Contact customer for payment confirmation\n` +
                    `3. Arrange delivery/pickup\n\n` +
                    `📞 Customer: +${customerPhone}`;
                
                notifyAdmins(adminNotification);
                
            } catch (error) {
                console.error('Error creating order:', error);
                await msg.reply('We apologize for the inconvenience. Our team has been notified and will contact you shortly at this number.\n\n📞 Or call us: +256 705 223 777');
            }
            
        } else {
            await msg.reply('*Order Cancelled*\n\nNo problem! Feel free to:\n\n▪️ Browse our *PRODUCTS*\n▪️ Contact us for assistance: +256 705 223 777\n\nThank you for considering AGROF.');
        }
        
        // Clear conversation state
        conversations.delete(msg.from);
    }
}

async function handlePriceInquiry(msg, text) {
    await msg.reply('Retrieving current pricing information...');
    
    try {
        const response = await fetch(`${STORE_API}/api/products?limit=30`);
        const products = await response.json();
        
        let priceMessage = `*AGROF PRICE LIST*\n_Current Market Prices_\n\n━━━━━━━━━━━━━━━━━━━━━━\n\n`;
        
        // Group by category
        const byCategory = {};
        products.forEach(p => {
            const cat = p.category_display_name || p.category_name || 'Other';
            if (!byCategory[cat]) byCategory[cat] = [];
            byCategory[cat].push(p);
        });
        
        for (const [category, items] of Object.entries(byCategory)) {
            priceMessage += `*${category.toUpperCase()}*\n\n`;
            items.slice(0, 5).forEach(p => {
                priceMessage += `▪️ ${p.name}\n   ${p.price}\n\n`;
            });
        }
        
        priceMessage += `━━━━━━━━━━━━━━━━━━━━━━\n\n`;
        priceMessage += `*To place an order:*\nReply: *ORDER [product name] [quantity]*\n\n`;
        priceMessage += `📞 Bulk orders: +256 705 223 777\n🌐 Full catalog: www.agrof.farm`;
        
        await msg.reply(priceMessage);
        
    } catch (error) {
        console.error('Error fetching prices:', error);
        await msg.reply('We apologize for the inconvenience. For pricing information, please contact:\n\n📞 +256 705 223 777\n📧 support@agrof.farm');
    }
}

