[
  {
    "name": "Auto Restock Alert",
    "description": "Automatically send alerts when product stock is low and create purchase orders",
    "category": "inventory",
    "icon": "📦",
    "is_popular": true,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "label": "Daily Check at 6 AM",
          "config": {
            "schedule": "daily_6am"
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "query_1",
          "type": "database_query",
          "label": "Find Low Stock Products",
          "config": {
            "query": "SELECT * FROM products WHERE quantity_in_stock <= minimum_stock_level",
            "params": []
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "condition_1",
          "type": "condition",
          "label": "Any Low Stock?",
          "config": {
            "condition": {
              "field": "queryResult.length",
              "operator": "greater_than",
              "value": 0
            }
          },
          "position": { "x": 500, "y": 100 }
        },
        {
          "id": "sms_1",
          "type": "send_sms",
          "label": "Alert Supplier",
          "config": {
            "phoneNumber": "+256700000000",
            "message": "Low stock alert! {{queryResult.length}} products need restocking."
          },
          "position": { "x": 700, "y": 50 }
        },
        {
          "id": "email_1",
          "type": "send_email",
          "label": "Email Admin",
          "config": {
            "to": "admin@agrof.com",
            "subject": "Low Stock Alert",
            "body": "The following products are low on stock: {{queryResult}}"
          },
          "position": { "x": 700, "y": 150 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "query_1" },
        { "from": "query_1", "to": "condition_1" },
        { "from": "condition_1", "to": "sms_1", "label": "true" },
        { "from": "condition_1", "to": "email_1", "label": "true" }
      ]
    }
  },
  {
    "name": "New Order Processing",
    "description": "Process new orders: reduce inventory, send confirmations, notify warehouse",
    "category": "operations",
    "icon": "🛒",
    "is_popular": true,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "event",
          "label": "New Order",
          "config": {
            "eventType": "order_created"
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "inventory_1",
          "type": "inventory_update",
          "label": "Reduce Stock",
          "config": {
            "productId": "{{order.productId}}",
            "quantity": "{{order.quantity}}",
            "operation": "remove"
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "sms_1",
          "type": "send_sms",
          "label": "Customer Confirmation",
          "config": {
            "phoneNumber": "{{order.customerPhone}}",
            "message": "Your order #{{order.id}} has been confirmed. Thank you!"
          },
          "position": { "x": 500, "y": 50 }
        },
        {
          "id": "notification_1",
          "type": "send_notification",
          "label": "Notify Warehouse",
          "config": {
            "title": "New Order",
            "body": "Order #{{order.id}} ready for preparation",
            "userId": "warehouse_staff"
          },
          "position": { "x": 500, "y": 150 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "inventory_1" },
        { "from": "inventory_1", "to": "sms_1" },
        { "from": "inventory_1", "to": "notification_1" }
      ]
    }
  },
  {
    "name": "Weekly Sales Report",
    "description": "Generate and email weekly sales reports every Monday",
    "category": "reporting",
    "icon": "📊",
    "is_popular": true,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "label": "Every Monday 9 AM",
          "config": {
            "schedule": "weekly_monday"
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "report_1",
          "type": "generate_report",
          "label": "Generate Sales Report",
          "config": {
            "reportType": "weekly_sales",
            "format": "pdf"
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "email_1",
          "type": "send_email",
          "label": "Email to Admin",
          "config": {
            "to": "admin@agrof.com",
            "subject": "Weekly Sales Report",
            "body": "Please find attached the weekly sales report.",
            "attachment": "{{report.file}}"
          },
          "position": { "x": 500, "y": 100 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "report_1" },
        { "from": "report_1", "to": "email_1" }
      ]
    }
  },
  {
    "name": "Product Expiry Alert",
    "description": "Monitor products nearing expiry and apply automatic discounts",
    "category": "inventory",
    "icon": "⚠️",
    "is_popular": false,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "label": "Daily at Noon",
          "config": {
            "schedule": "daily_noon"
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "query_1",
          "type": "database_query",
          "label": "Find Expiring Products",
          "config": {
            "query": "SELECT * FROM products WHERE expiry_date <= date('now', '+30 days') AND expiry_date IS NOT NULL",
            "params": []
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "condition_1",
          "type": "condition",
          "label": "Any Expiring Soon?",
          "config": {
            "condition": {
              "field": "queryResult.length",
              "operator": "greater_than",
              "value": 0
            }
          },
          "position": { "x": 500, "y": 100 }
        },
        {
          "id": "update_1",
          "type": "update_product",
          "label": "Apply 20% Discount",
          "config": {
            "productId": "{{product.id}}",
            "updates": {
              "price": "{{product.price * 0.8}}"
            }
          },
          "position": { "x": 700, "y": 50 }
        },
        {
          "id": "notification_1",
          "type": "send_notification",
          "label": "Alert Staff",
          "config": {
            "title": "Products Expiring Soon",
            "body": "{{queryResult.length}} products are expiring within 30 days",
            "userId": "all_staff"
          },
          "position": { "x": 700, "y": 150 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "query_1" },
        { "from": "query_1", "to": "condition_1" },
        { "from": "condition_1", "to": "update_1", "label": "true" },
        { "from": "condition_1", "to": "notification_1", "label": "true" }
      ]
    }
  },
  {
    "name": "Customer Re-engagement",
    "description": "Send promotional messages to customers who haven't purchased in 30 days",
    "category": "marketing",
    "icon": "💌",
    "is_popular": false,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "label": "Weekly on Friday",
          "config": {
            "schedule": {
              "type": "weekly",
              "dayOfWeek": 5,
              "time": "10:00"
            }
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "query_1",
          "type": "database_query",
          "label": "Find Inactive Customers",
          "config": {
            "query": "SELECT DISTINCT customer_id, customer_phone FROM orders WHERE created_at < date('now', '-30 days')",
            "params": []
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "sms_1",
          "type": "send_sms",
          "label": "Send Promo SMS",
          "config": {
            "phoneNumber": "{{customer.phone}}",
            "message": "We miss you! Get 15% OFF your next purchase with code WELCOME15. Shop now at AGROF!"
          },
          "position": { "x": 500, "y": 100 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "query_1" },
        { "from": "query_1", "to": "sms_1" }
      ]
    }
  },
  {
    "name": "Price Update from Supplier",
    "description": "Update product prices automatically when supplier sends price list",
    "category": "operations",
    "icon": "💰",
    "is_popular": false,
    "workflow_definition": {
      "nodes": [
        {
          "id": "trigger_1",
          "type": "webhook",
          "label": "Supplier Webhook",
          "config": {
            "method": "POST",
            "authentication": "api_key"
          },
          "position": { "x": 100, "y": 100 },
          "is_trigger": true
        },
        {
          "id": "transform_1",
          "type": "transform",
          "label": "Parse Price Data",
          "config": {
            "transformations": {
              "productId": "data.product_id",
              "newPrice": "data.price"
            }
          },
          "position": { "x": 300, "y": 100 }
        },
        {
          "id": "update_1",
          "type": "update_product",
          "label": "Update Product Price",
          "config": {
            "productId": "{{productId}}",
            "updates": {
              "selling_price": "{{newPrice}}",
              "cost_price": "{{newPrice * 0.7}}"
            }
          },
          "position": { "x": 500, "y": 100 }
        },
        {
          "id": "email_1",
          "type": "send_email",
          "label": "Notify Admin",
          "config": {
            "to": "admin@agrof.com",
            "subject": "Price Updated",
            "body": "Product {{productId}} price updated to {{newPrice}}"
          },
          "position": { "x": 700, "y": 100 }
        }
      ],
      "connections": [
        { "from": "trigger_1", "to": "transform_1" },
        { "from": "transform_1", "to": "update_1" },
        { "from": "update_1", "to": "email_1" }
      ]
    }
  }
]



