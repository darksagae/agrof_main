# EAS Build Ignore File - Reduce Archive Size
# This file excludes unnecessary files from the EAS build archive

# Large model files (keep TFLite, exclude H5 backup)
models_backup/
*.h5
*.hdf5

# Node modules (will be installed during build)
node_modules/

# Development files
.expo/
.expo-shared/
dist/
build/
web-build/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git files
.git/
.gitignore

# Documentation files
*.md
docs/

# Test files
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Large binary files that aren't needed for build
automation-engine/
whatsapp-bot/
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak
*.tmp

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
